{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/dental-scrap-buyer", "destination": "/dental-scrap", "permanent": true },
    { "source": "/watch-battery-recycling", "destination": "/silver-oxide-watch-batteries", "permanent": true },
    { "source": "/x-ray-recycling", "destination": "/x-ray-film-recycling", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true }
  ]
}
